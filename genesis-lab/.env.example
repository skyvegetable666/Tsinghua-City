# ============================================================================
# Genesis Lab - configuration
# Copy to .env and fill in the API key. The orchestrator reads this file.
# ============================================================================

# --- DeepSeek through its Anthropic-compatible endpoint (Claude Code) -------
# Get a key at https://platform.deepseek.com/ ; the key is provided later.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-REPLACE_ME
ANTHROPIC_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash
CLAUDE_CODE_EFFORT_LEVEL=max
CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000

# --- host broker ------------------------------------------------------------
BROKER_HOST=0.0.0.0
BROKER_PORT=8787
# Optional fixed run token. Leave empty to generate a fresh token per run.
# Containers receive their own derived tokens, never this one.
BROKER_TOKEN=
# Optional URL that containers use to reach the host broker. Empty means
# http://host.docker.internal:<BROKER_PORT>, which works for native Linux
# (compose extra_hosts host-gateway) and Docker Desktop.
# For WSL2 + Docker Desktop where the supervisor runs inside WSL, set the WSL
# address explicitly, e.g. BROKER_URL=http://172.20.10.2:8787
BROKER_URL=

# --- identities -------------------------------------------------------------
# Preferred: a JSON array of agent names, in order. IDs are a, b, c, ...
# AGENTS='[{"name":"agent-a"},{"name":"agent-b"},{"name":"agent-c"}]'
# Simpler comma-separated alternative:
# AGENT_NAMES=agent-a,agent-b,agent-c
# If neither is set, the legacy A/B pair below is used.
AGENTS=
AGENT_NAMES=
AGENT_A_NAME=agent-a
AGENT_B_NAME=agent-b

# --- messaging --------------------------------------------------------------
MAX_MESSAGE_CHARS=4000
HOOK_BATCH_MAX_CHARS=8000
# 0 disables the limit.
RUN_MAX_MESSAGES=0
RUN_MAX_SECONDS=0
# How long agents get to wrap up after "end" before containers are stopped.
END_GRACE_SECONDS=45

# --- agent image / harness --------------------------------------------------
AGENT_IMAGE=genesis-lab-agent:latest
AGENT_HARNESS=claude

# --- dry run without an API key --------------------------------------------
MOCK_LLM_PORT=8790

# --- paths (relative to the project root) -----------------------------------
WORLD_FILE=config/world.md
MISSION_FILE=config/mission.md
GENESIS_FILE=config/genesis.md
