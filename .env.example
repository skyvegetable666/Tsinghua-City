# World service
# For local development SQLite is fine. Use a Postgres URL for a real run.
CITY_DATABASE_URL=sqlite:///./runs/city.db

# Change this for any experiment you care about.
CITY_ADMIN_TOKEN=change-me

CITY_HOST=127.0.0.1
CITY_PORT=8000
CITY_LOG_LEVEL=info

# In-process maintenance sweep (task deadlines / agent death)
CITY_SCHEDULER_ENABLED=1
CITY_SCHEDULER_INTERVAL_SECONDS=5

# Runtime manager
CITY_API_URL=http://127.0.0.1:8000
CITY_RUNTIME_LOG_DIR=runs/runtime

# MCP client (usually set inside the agent container/harness)
# CITY_API_URL=http://host.docker.internal:8000
# CITY_AGENT_TOKEN=city_...
