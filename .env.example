# World service
# For local development SQLite is fine. Use a Postgres URL for a real run.
CITY_DATABASE_URL=sqlite:///./runs/city.db

# Change this for any experiment you care about.
CITY_ADMIN_TOKEN=change-me

CITY_HOST=127.0.0.1
CITY_PORT=8000
CITY_LOG_LEVEL=info

# In-process maintenance sweep (task deadlines / agent death)
CITY_SCHEDULER_ENABLED=1
CITY_SCHEDULER_INTERVAL_SECONDS=5

# Runtime manager
CITY_API_URL=http://127.0.0.1:8000
CITY_RUNTIME_LOG_DIR=runs/runtime
CITY_TRACE_DIR=runs/transcripts

# Docker sandbox (build with: docker build -f deploy/agent.Dockerfile -t tsinghua-city-agent:0.1 .)
CITY_DOCKER_IMAGE=tsinghua-city-agent:0.1
CITY_DOCKER_API_URL=http://host.docker.internal:8000
CITY_DOCKER_MEMORY=1g
CITY_DOCKER_CPUS=1
CITY_DOCKER_PIDS_LIMIT=128
# Export ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN in the server environment.
# Optional: ANTHROPIC_BASE_URL / ANTHROPIC_MODEL / ANTHROPIC_DEFAULT_*_MODEL.
# These are runtime-only; never put credentials in an image or runtime command.

# MCP client (usually set inside the agent container/harness)
# CITY_API_URL=http://host.docker.internal:8000
# CITY_AGENT_TOKEN=city_...
